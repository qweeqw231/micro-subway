    "slotCount": 3,
    "autosaveIntervalSec": 15,
    "schemaVersion": 1,
    "maxImportBytes": 2097152,
    "retrySnapshotSeparate": true,
    "backupOnImport": true,
    "fileNamePattern": "linevale-save-slot{slot}-v{schemaVersion}.json",
    "retryFileNamePattern": "linevale-retry-slot{slot}.json",
    "settingsFileName": "linevale-settings.json",
    "profileFileName": "linevale-profile.json",
    "backupFileNamePattern": "linevale-save-slot{slot}-v{schemaVersion}.backup-{timestamp}.json",
    "webKeys": {
      "save": "linevale.save.slot{slot}",
      "retry": "linevale.retry.slot{slot}",
      "settings": "linevale.settings",
      "profile": "linevale.profile"
    },
    "desktopPaths": {
      "saveDir": "%APPDATA%\\Linevale\\saves",
      "retryDir": "%APPDATA%\\Linevale\\retry",
      "settingsFile": "%APPDATA%\\Linevale\\linevale-settings.json",
      "profileFile": "%APPDATA%\\Linevale\\linevale-profile.json"
    }
  },
  "_meta": {
    "note": "以下划线开头的键仅供阅读，加载器应忽略。各参数的推荐范围与依据见 GDD 第 6 节。",
    "tuningOrder": [
      "demand.baseRatePerStation",
      "stations.overloadGraceSec",
      "routing.transferPenaltySec",
      "trains.speedPxPerSec",
      "demand.weeklyGrowth"
    ]
  }
}
